# Real provider mode. Add API endpoints and keys in the web settings page.
APP_MODE=live
MAX_QUEUE=50
TASK_WORKERS=2
MOCK_DELAY=1.1
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=0

# Live mode only. Generate distinct, long random tokens outside this repository.
AUTH_ADMIN_TOKEN=
AUTH_OPERATOR_TOKEN=
AUTH_VIEWER_TOKEN=

# Operator-owned endpoints only. Leave empty until you intentionally connect a node.
# Container-to-Mac host access can use host.docker.internal where supported.
HERMES_BRIDGE_URL=
HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_SAFE_MODE=0
LOCAL_BASE_URL=
LOCAL_MODEL=local-model
CLOUD_BASE_URL=
CLOUD_MODEL=configured-model
CLOUD_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=configured-judge
JUDGE_API_KEY=

# Optional public-web MCP controls. Install from the settings page.
WEB_MAX_TOOL_STEPS=12
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# BROWSER_RUNTIME_PATH=

# Maximum individual evidence upload size (32 MiB). Not a model output or spending limit.
MAX_FILE_BYTES=33554432

# Secure deployment: enroll locally first; see docs/SECURITY-DEPLOYMENT.md
EXPOSURE_MODE=local
# MCP_STDIO_MANIFEST=/absolute/path/to/owner-managed-profiles.json
# PDF_UPLOADS=disabled
# HTTP_MAX_CONNECTIONS=32
# HTTP_READ_TIMEOUT=15
# HTTP_BODY_DEADLINE=30
